{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string",
      "description": "N\u00famero da venda"
    },
    "items": {
      "type": "array",
      "description": "Itens da venda",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "unit_type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal da venda"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto aplicado"
    },
    "total": {
      "type": "number",
      "description": "Total da venda"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "debito",
        "credito",
        "vale"
      ],
      "description": "Forma de pagamento"
    },
    "amount_paid": {
      "type": "number",
      "description": "Valor pago"
    },
    "change": {
      "type": "number",
      "description": "Troco"
    },
    "operator": {
      "type": "string",
      "description": "Operador do caixa"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "pending"
      ],
      "default": "completed"
    }
  },
  "required": [
    "items",
    "total",
    "payment_method"
  ]
}